# --- Local testing only. On Render you enter these as Environment Variables instead. ---
API_KEY=sk-or-v1-paste-your-openrouter-key-here
BASE_URL=https://openrouter.ai/api/v1
# Pick any model from openrouter.ai/models — examples below:
# anthropic/claude-sonnet-4-5
# google/gemini-2.5-pro
# deepseek/deepseek-r1
# meta-llama/llama-3.3-70b-instruct
# openai/gpt-4.1
MODEL=anthropic/claude-sonnet-4-5
SECRET_KEY=paste-a-long-random-string-here
# Leave DATABASE_URL empty locally (uses a local file). On Render paste your Neon connection string.
DATABASE_URL=
FREE_MESSAGES=10
MEMBER_DAILY=20
GLOBAL_DAILY_CAP=200
PRODUCTION=0
